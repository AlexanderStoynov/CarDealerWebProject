@using CarDealerWebProject.Core.Models.Vehicle.SeviceModels
@using CarDealerWebProject.Infrastructure.Data.Enums
@model IEnumerable<VehiclePreviewServiceModel>

@{
    ViewData["Title"] = "Home Page";
    var vehicles = Model.ToList();
}

<h1 class="display-4 text-center">Welcome to the best place for buying vehicles!</h1>

@if (!vehicles.Any())
{
    <div class="mt-4 p-5 bg-light text-center">
        <p class="lead">
            There are no vehicles currently available.
        </p>
        <hr class="my-4">
        @if (User.Identity!.IsAuthenticated &&
        (User.IsInRole("Admin") || User.IsInRole("Seller")))
        {
            <a asp-controller="Vehicle" asp-action="SelectVehicleCreationType" class="btn btn-primary btn-lg" role="button">Add Vehicle</a>
        }
    </div>
}

else
{
    <div class="mb-5"></div>
    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < vehicles.Count(); i++)
            {
                var vehicle = vehicles[i];

                <div class="carousel-item @(i == 0 ? "active" : string.Empty)">
                    @if (!string.IsNullOrEmpty(vehicle.FirstVehicleImage))
                    {
                        <img class="d-block w-100" style="height:550px; object-fit:cover" alt="@vehicle.Make @vehicle.Model" src="@vehicle.FirstVehicleImage" />
                    }
                    else
                    {
                        if (vehicle.VehicleType == VehicleTypes.Car)
                        {
                            <img class="d-block w-100" style="height:550px; object-fit:cover" alt="@vehicle.Make @vehicle.Model" src="~/images/defaultImages/default-car-image.jpg" class="img-fluid mb-2" />
                        }

                        else if (vehicle.VehicleType == VehicleTypes.Motorcycle)
                        {
                            <img class="d-block w-100" style="height:550px; object-fit:cover" alt="@vehicle.Make @vehicle.Model" src="~/images/defaultImages/default-motorcycle-image.jpg" class="img-fluid mb-2" />
                        }
                    }

                    <div class="mt-3 text-center">
                        <h5>
                            <a class="btn btn-primary" asp-controller="Vehicle" asp-action="VehicleDetails"
                               asp-route-id="@vehicle.Id" asp-route-information="@vehicle.GetInformation()"> @vehicle.Make @vehicle.Model</a>
                        </h5>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}



