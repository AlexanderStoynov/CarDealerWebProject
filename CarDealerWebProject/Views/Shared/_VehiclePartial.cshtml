@using CarDealerWebProject.Core.Models.Vehicle.SeviceModels
@using CarDealerWebProject.Infrastructure.Data.Enums
@model VehiclePreviewServiceModel

<div class="col-md-4">
    <div class="card mb-3">
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.FirstVehicleImage))
            {

                <img src="@Model.FirstVehicleImage" class="img-fluid mb-2" />

            }
            else
            {
                if (Model.VehicleType == VehicleTypes.Car)
                {
                    <img src="~/images/default-car-image.jpg" class="img-fluid mb-2" />
                }

                else if (Model.VehicleType == VehicleTypes.Motorcycle)
                {
                    <img src="~/images/default-motorcycle-image.jpg" class="img-fluid mb-2" />
                }
            }
        </div>
        <div class="card-body text-center">
            <h4>@Model.Make @Model.Model</h4>
            <h6>Price: <b>@String.Format("{0:f2}", Model.Price) EUR</b></h6>
            <br />
            <a asp-controller="Vehicle" asp-action="VehicleDetails" asp-route-id="@Model.Id"
               asp-route-information="@Model.GetInformation()" class="btn btn-success">Details</a>
            @if (this.User.Identity!.IsAuthenticated &&
            (User.IsInRole("Admin") || User.IsInRole("Seller")))
            {
                <a asp-controller="Vehicle" asp-action="EditVehicle" asp-route-id="@Model.Id"
                   class="btn btn-warning">Edit</a>
                <a asp-controller="Vehicle" asp-action="DeleteVehicle" asp-route-id="@Model.Id"
                   class="btn btn-danger">Delete</a>
                <p></p>
            }
        </div>
    </div>
</div>
